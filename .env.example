# Atlazora Core local configuration example
# Copy these values into your process environment for local development.
# The application reads process environment variables; it does not load this file automatically.
# Replace change-me with the local PostgreSQL password from the governed local platform configuration.

ATLAZORA_ENV=development
ATLAZORA_HTTP_ADDR=:8080
ATLAZORA_DATABASE_URL=postgres://atlazora:change-me@127.0.0.1:15432/atlazora?sslmode=disable
ATLAZORA_SHUTDOWN_TIMEOUT=10s
